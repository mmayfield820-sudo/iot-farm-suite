# 智慧农业全栈部署配置模板
# 使用：复制为 .env 并填写真实值（.env 已被 .gitignore 排除，不会进 Git）
#   cp .env.example .env   （Windows: copy .env.example .env）

# ─── 数据库（MySQL 8.0，compose 里自动建库建表）───
MYSQL_DATABASE=farm
MYSQL_USER=farm
MYSQL_PASSWORD=farm
MYSQL_ROOT_PASSWORD=farm-root

# ─── MQTT（EMQX）───
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── 后端鉴权（必填！改成一个长随机串）───
# Windows 生成: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION_MINUTES=1440
PUBLIC_REGISTRATION_ENABLED=true

# ─── 服务间地址（compose 容器名，一般不用改）───
DATABASE_URL=mysql://farm:farm@mysql:3306/farm
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT_SECONDS=120

# ─── AI 服务（RAG 问答）───
# DeepSeek API（硅基流动平台，OpenAI 兼容）。本地 Ollama 时改 http://<ip>:11434/v1
AI_MODEL_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL_API_KEY=sk-your-siliconflow-key
AI_MODEL_NAME=deepseek-ai/DeepSeek-V3.2
AI_MODEL_TIMEOUT_SECONDS=120
# 联网搜索（博查 open.bochaai.com，留空=关闭联网回答）
BOCHA_API_KEY=
BOCHA_TIMEOUT_SECONDS=10
AI_LOCAL_TIMEZONE=Asia/Shanghai

# ─── 设备/遥测超时（可默认）───
TELEMETRY_PAIR_TIMEOUT_SECONDS=30
DEVICE_OFFLINE_TIMEOUT_SECONDS=90
COMMAND_ACK_TIMEOUT_SECONDS=30

# ─── 前端（构建期参数，一般默认 /api）───
VITE_API_BASE_URL=/api

# ─── 二期天气服务（mock 即可，无需真 API）───
WEATHER_MODE=mock
WEATHER_MOCK_SCENARIO=SUNNY
WEATHER_CACHE_MINUTES=15
WEATHER_SERVICE_TIMEOUT_SECONDS=10
# WEATHER_API_URL=https://your-weather-provider.example/forecast
